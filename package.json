{
  "name": "bravais",
  "version": "0.2.0",
  "description": "A minimal crystal structure viewer for the web: reads CIF files and draws them with three.js.",
  "license": "MIT",
  "author": "Jiacheng Wang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcwang587/bravais.git"
  },
  "homepage": "https://jcwang.dev/bravais/",
  "bugs": {
    "url": "https://github.com/jcwang587/bravais/issues"
  },
  "keywords": [
    "crystal",
    "crystallography",
    "cif",
    "crystal-structure",
    "viewer",
    "three.js",
    "webgl",
    "space-group",
    "materials-science"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/bravais.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/bravais.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples/CoO.cif",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "demo": "vite --config vite.demo.config.ts --open",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:site": "vite build --config vite.demo.config.ts",
    "dev": "vite build --watch",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && prettier --check .",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "format": "prettier --write .",
    "prepublishOnly": "npm run check && npm test && npm run build && npm run check:package"
  },
  "peerDependencies": {
    "three": ">=0.186.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@spglib/moyo-wasm": "^0.21.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
